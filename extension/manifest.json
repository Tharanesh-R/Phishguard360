{
  "manifest_version": 3,
  "name": "PhishGuard 360",
  "description": "AI-Powered Phishing Detector with Fortinet-Style Auto-Blocking",
  "version": "5.0",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishGuard 360 — Auto-Block Protection"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "webNavigation",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "block.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}